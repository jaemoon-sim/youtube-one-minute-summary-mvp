# Server
PORT=3000
DATA_DIR=./data
JOB_TTL_HOURS=24

# Gemini video understanding
# YouTube URL support is handled via the Gemini REST generateContent endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Text-to-Speech.
# Prefer ADC/service account JSON or an OAuth access token.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_ACCESS_TOKEN=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_SPEAKING_RATE=1.08

# Capture
# false keeps development local and uses generated placeholder stills.
# true tries Playwright screenshots of the YouTube embed player.
ENABLE_REAL_CAPTURE=false

# Development fallback
# true lets the app run end-to-end without paid API keys.
ALLOW_DEMO_FALLBACK=true
